# Database connection
# On Windows with Podman Desktop, use host.containers.internal to reach the host machine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# MCP transport: stdio (default, used by GitHub Copilot via Podman) or streamable-http (remote deploy)
MCP_TRANSPORT=stdio

# Port used only when MCP_TRANSPORT=streamable-http
MCP_PORT=8000
